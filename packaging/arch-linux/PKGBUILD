# Maintainer: Matvei Igumnov <matvei@iqumnov.com>
pkgname=pqcanary-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Universal Post-Quantum Cryptographic Security Scanner & CBOM Generator (NIST FIPS 203/204)"
arch=('x86_64' 'aarch64')
url="https://pqcanary.iqumnov.com"
license=('Apache-2.0')
provides=('pqcanary' 'pqcanary-mcp')
conflicts=('pqcanary')
source_x86_64=("https://github.com/Iqumnov/PQCanary/releases/download/v${pkgver}/pqcanary-v${pkgver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/Iqumnov/PQCanary/releases/download/v${pkgver}/pqcanary-v${pkgver}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    install -Dm755 "${srcdir}/pqcanary" "${pkgdir}/usr/bin/pqcanary"
    if [ -f "${srcdir}/pqcanary-mcp" ]; then
        install -Dm755 "${srcdir}/pqcanary-mcp" "${pkgdir}/usr/bin/pqcanary-mcp"
    fi
}

